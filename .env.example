# Copy to `.env` and adjust. The server reads `.env` from the working directory at
# startup; real environment variables and command-line flags take precedence.
# `.env` is git-ignored: keep API keys there (or in your host's secret store), never in code.

# --- Network
UMBRA_HOST=127.0.0.1
# Hosting platforms that set PORT are honoured when UMBRA_PORT is unset.
UMBRA_PORT=8080
# Behind HTTPS (required for location and iPhone install): HSTS + Secure cookies.
UMBRA_HTTPS=off
# Behind a reverse proxy / load balancer: take the client IP from X-Forwarded-For.
UMBRA_TRUST_PROXY=off
# API requests per second per client IP (0 = off). Campus Wi-Fi users may share one IP.
UMBRA_RATE_LIMIT=20

# --- Data (OpenStreetMap extracts; see data/README.md)
UMBRA_DATA=data/tempe.osm.json
UMBRA_PLACES=data/tempe.places.json
UMBRA_CAMPUS=data/tempe.campus.json
UMBRA_WATER=data/tempe.water.json
UMBRA_WALK=data/tempe.walk.osm.json
UMBRA_SHADE=data/tempe.shade.json
UMBRA_WEB_DIR=web
UMBRA_REGION="Tempe, Arizona"
UMBRA_TIMEZONE=America/Phoenix

# --- Accounts (SQLite file, or "off")
UMBRA_DB=var/umbra.db

# --- Live weather (Open-Meteo, no key). Only the map's centre is sent.
UMBRA_WEATHER=on

# --- Live traffic (optional). Free key: https://platform.here.com  ->  REST API key
HERE_API_KEY=

# --- Trip assistant (optional). Key: https://console.x.ai  (billed per token)
XAI_API_KEY=
UMBRA_XAI_MODEL=grok-4.7
